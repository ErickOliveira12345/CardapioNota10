rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function ehAdministrador() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "super_admin"
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "active";
    }

    function ehEntregadorAprovado() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/deliveryDrivers/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/deliveryDrivers/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && get(
          /databases/$(database)/documents/deliveryDrivers/$(request.auth.uid)
        ).data.status == "approved";
    }

    function podeAceitarEntrega() {
      return ehEntregadorAprovado()

        /*
        * Estado atual do pedido.
        */
        && resource.data.tipoPedido
          == "entrega"

        && resource.data.entregaPremium
          == true

        && resource.data.entregaDisponivel
          == true

        && resource.data.statusEntrega
          == "aguardando_entregador"

        && resource.data.entregadorUid
          == null

        /*
        * Estado novo do pedido.
        */
        && request.resource.data.entregadorUid
          == request.auth.uid

        && request.resource.data.entregaDisponivel
          == false

        && request.resource.data.statusEntrega
          == "aceita"

        /*
        * O entregador só pode modificar
        * estes campos.
        */
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "entregadorUid",
            "entregaDisponivel",
            "statusEntrega",
            "aceitoEm",
            "atualizadoEm",
            "atualizadoEmMs"
          ]);
    }

    function podeAtualizarEntregaAceita() {
      return ehEntregadorAprovado()

        && resource.data.tipoPedido
          == "entrega"

        && resource.data.entregadorUid
          == request.auth.uid

        && request.resource.data.entregadorUid
          == resource.data.entregadorUid

        && (
          /*
          * aceita -> retirado
          */
          (
            resource.data.statusEntrega
              == "aceita"

            && request.resource.data.statusEntrega
              == "retirado"

            && request.resource.data.status
              == resource.data.status
          )

          ||

          /*
          * retirado -> em_rota
          */
          (
            resource.data.statusEntrega
              == "retirado"

            && request.resource.data.statusEntrega
              == "em_rota"

            && request.resource.data.status
              == resource.data.status
          )

          ||

          /*
          * em_rota -> entregue
          *
          * Aqui também finaliza o pedido
          * para cliente e estabelecimento.
          */
          (
            resource.data.statusEntrega
              == "em_rota"

            && request.resource.data.statusEntrega
              == "entregue"

            && request.resource.data.status
              == "finalizado"

            && request.resource.data.entregaDisponivel
              == false
          )
        )

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "statusEntrega",
            "status",
            "entregaDisponivel",
            "atualizadoEm",
            "atualizadoEmMs",
            "entregueEm",
            "entregueEmMs",
            "finalizadoEm",
            "finalizadoEmMs"
          ]);
    }

    /*
 * Registros de auditoria da plataforma.
 */
  match /auditLogs/{logId} {
    allow read, create: if ehAdministrador();
    allow update, delete: if false;
  }

    function ehProprioUsuario(userId) {
      return estaAutenticado()
        && request.auth.uid == userId;
    }

    function ehProprietario(establishmentId) {
      return estaAutenticado()
        && (
          (
            exists(
              /databases/$(database)/documents/establishments/$(establishmentId)
            )
            && get(
              /databases/$(database)/documents/establishments/$(establishmentId)
            ).data.ownerId == request.auth.uid
          )
          ||
          (
            existsAfter(
              /databases/$(database)/documents/establishments/$(establishmentId)
            )
            && getAfter(
              /databases/$(database)/documents/establishments/$(establishmentId)
            ).data.ownerId == request.auth.uid
          )
        );
    }

    function podeGerenciarEstabelecimento(
      establishmentId
    ) {
      return ehAdministrador()
        || ehProprietario(establishmentId)
        || (
          pertenceAoEstabelecimento(
            establishmentId
          )
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.status == "active"
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.permissoes is map
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.permissoes.configuracoes == true
        );
    }

    function pertenceAoEstabelecimento(establishmentId) {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.estabelecimentoId == establishmentId;
    }

    function podeVerAssinatura() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "subscriber"

          || get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "owner"

          || (
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.permissoes is map

            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.permissoes.assinatura == true
          )
        );
    }

    /*
     * Usuários do Firebase Authentication.
     */
    match /users/{userId} {
      allow create: if ehProprioUsuario(userId)
        && request.resource.data.keys().hasAll([
          'nome',
          'email',
          'role',
          'status',
          'estabelecimentoId',
          'criadoEm',
          'atualizadoEm'
        ])
        && request.resource.data.role == 'subscriber'
        && request.resource.data.status == 'onboarding'
        && request.resource.data.estabelecimentoId == null;

      allow read: if ehProprioUsuario(userId)
        || ehAdministrador();

      allow update: if ehAdministrador()
        || (
          ehProprioUsuario(userId)

          && request.resource.data.role
            == resource.data.role

          && request.resource.data.email
            == resource.data.email

          && (
            request.resource.data.estabelecimentoId
              == resource.data.estabelecimentoId

            || (
              resource.data.estabelecimentoId
                == null

              && request.resource.data.estabelecimentoId
                is string

              && request.resource.data.status
                == 'active'
            )
          )
        );

      allow delete: if false;
    }

    /*
     * Os planos podem ser vistos na página comercial.
     * Somente administradores poderão alterá-los.
     */
    match /plans/{planId} {
      allow read: if true;
      allow create, update, delete: if ehAdministrador();
    }

    /*
     * Assinaturas serão controladas posteriormente
     * pelo administrador e pelas Cloud Functions.
     */
    match /subscriptions/{subscriptionId} {
      allow create: if estaAutenticado()
        && request.resource.data.userId
          == request.auth.uid
        && request.resource.data.establishmentId
          == subscriptionId
        && request.resource.data.planId
          == 'basic'
        && request.resource.data.status
          == 'trial'
        && request.resource.data.valorAtual
          == 0;

      allow read: if ehAdministrador()
        || (
          estaAutenticado()
          && resource.data.userId
            == request.auth.uid
        )
        || (
          podeVerAssinatura()
          && pertenceAoEstabelecimento(
            resource.data.establishmentId
          )
        );

      /*
      * Somente o Super Admin pode alterar
      * uma assinatura diretamente.
      */
      
      allow update: if ehAdministrador();

      allow update, delete: if false;
    }

    match /subscriptionPayments/{paymentId} {
      allow read: if ehAdministrador()
        || (
          estaAutenticado()
          && resource.data.userId
            == request.auth.uid
        )
        || (
          podeVerAssinatura()
          && pertenceAoEstabelecimento(
            resource.data.establishmentId
          )
        );

      allow create, update, delete: if false;
    }

    /*
     * Documento principal do estabelecimento.
     */
    match /establishments/{establishmentId} {
      allow create: if estaAutenticado()
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if resource.data.status == 'active'
        || podeGerenciarEstabelecimento(establishmentId);

      allow update: if podeGerenciarEstabelecimento(
        establishmentId
      );

      allow delete: if false;

      /*
       * Cardápio público.
       */
      match /categories/{categoryId} {
        allow read: if true;

        allow create, update, delete:
          if podeGerenciarEstabelecimento(
            establishmentId
          );
      }

      match /products/{productId} {
        allow read: if true;

        allow create, update, delete:
          if podeGerenciarEstabelecimento(
            establishmentId
          );
      }

      match /tables/{tableId} {
        allow read: if true;

        allow create, update, delete:
          if podeGerenciarEstabelecimento(
            establishmentId
          );
      }

      /*
       * Funcionários.
       */
      match /employees/{employeeId} {
        allow read: if podeGerenciarEstabelecimento(
          establishmentId
        );

        allow create, update, delete:
          if podeGerenciarEstabelecimento(
            establishmentId
          );
      }

      /*
       * Pedidos.
       *
       * Clientes podem criar pedidos sem login.
       * O painel precisa estar autenticado para
       * ler e alterar todos os pedidos.
       */
      match /orders/{orderId} {
        allow create: if
          estaAutenticado()

          && request.resource.data.clienteUid
            == request.auth.uid

          && request.resource.data.tipoPedido
            in ["mesa", "entrega"]

          && request.resource.data.itens is list

          && request.resource.data.itens.size() > 0

          && request.resource.data.total is number

          && request.resource.data.total >= 0

          && request.resource.data.status
            == "aguardando"

          && (
            /*
            * Pedido feito na mesa.
            */
            (
              request.resource.data.tipoPedido
                == "mesa"

              && request.resource.data.mesa is int

              && request.resource.data.mesa > 0
            )

            ||

            /*
            * Pedido para entrega.
            */
            (
              request.resource.data.tipoPedido
                == "entrega"

              && request.resource.data.mesa == null

              && request.resource.data.cliente is map

              && request.resource.data.cliente.nome
                is string

              && request.resource.data.cliente.nome
                != ""

              && request.resource.data.cliente.telefone
                is string

              && request.resource.data.cliente.telefone
                != ""

              && request.resource.data.entrega is map

              && request.resource.data.entrega.localizacao
                is map

              && request.resource.data.entrega.localizacao.latitude
                is number

              && request.resource.data.entrega.localizacao.longitude
                is number

              && request.resource.data.entrega.rota
                is map
            )
          );

        allow read: if
          podeGerenciarEstabelecimento(
            establishmentId
          )

          || (
            estaAutenticado()
            && resource.data.clienteUid
              == request.auth.uid
          )

          || (
            ehEntregadorAprovado()
            &&
            (
              /*
              * Entregas disponíveis.
              */
              (
                resource.data.tipoPedido
                  == "entrega"

                && resource.data.entregaPremium
                  == true

                && resource.data.entregaDisponivel
                  == true

                && resource.data.statusEntrega
                  == "aguardando_entregador"
              )

              ||

              /*
              * Entregas já aceitas pelo
              * entregador autenticado.
              */
              (
                resource.data.tipoPedido
                  == "entrega"

                && resource.data.entregadorUid
                  == request.auth.uid
              )
            )
          );

        allow update: if
          podeGerenciarEstabelecimento(
            establishmentId
          )
          || podeAceitarEntrega()
          || podeAtualizarEntregaAceita();

        allow delete: if false;
      }

      /*
      * Chamados de atendimento.
      */
      match /serviceCalls/{callId} {

        // Permite criar um chamado
        allow create: if
          request.resource.data.mesa is int
          && request.resource.data.mesa > 0
          && request.resource.data.visualizado == false;

        // Permite consultar chamados (necessário para verificar
        // se a mesa já possui um chamado aberto)
        allow read: if true;

        // Apenas administradores podem marcar como atendido
        allow update: if
          podeGerenciarEstabelecimento(
            establishmentId
          );

        allow delete: if false;
      }

      /*
      * Pagamentos / Caixa.
      */
      match /payments/{paymentId} {

        allow create: if
          podeGerenciarEstabelecimento(
            establishmentId
          );

        allow read: if
          podeGerenciarEstabelecimento(
            establishmentId
          );

        allow update: if
          podeGerenciarEstabelecimento(
            establishmentId
          );

        allow delete: if false;
      }

      match /settings/general {
        allow read: if true;

        allow create, update:
          if podeGerenciarEstabelecimento(
            establishmentId
          );

        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read, write:
          if podeGerenciarEstabelecimento(
            establishmentId
          );
      }
    }

    /*
    * Consulta global de pedidos
    * para entregadores.
    *
    * Necessário para:
    * collectionGroup(db, "orders")
    */
    match /{path=**}/orders/{orderId} {

      /*
      * Entregas disponíveis.
      */
      allow read: if
        ehEntregadorAprovado()

        && resource.data.tipoPedido
          == "entrega"

        && resource.data.entregaPremium
          == true

        && resource.data.entregaDisponivel
          == true

        && resource.data.statusEntrega
          == "aguardando_entregador";


      /*
      * Entregas que já pertencem
      * ao entregador autenticado.
      */
      allow read: if
        ehEntregadorAprovado()

        && resource.data.tipoPedido
          == "entrega"

        && resource.data.entregadorUid
          == request.auth.uid;
    }


    /*
    * Entregadores globais.
    */
    match /deliveryDrivers/{driverId} {

      /*
      * Cadastro do entregador.
      */
      allow create: if
        estaAutenticado()

        && request.auth.uid
          == driverId

        && request.resource.data.uid
          == request.auth.uid

        && request.resource.data.status
          == "pending"

        && request.resource.data.disponivel
          == false

        && request.resource.data.nome
          is string

        && request.resource.data.telefone
          is string

        && request.resource.data.email
          is string

        && request.resource.data.cpf
          is string

        && request.resource.data.veiculo
          is map;


      /*
      * O entregador pode consultar
      * somente o próprio cadastro.
      *
      * Super Admin pode consultar todos.
      */
      allow read: if
        (
          estaAutenticado()

          && request.auth.uid
            == driverId
        )

        || ehAdministrador();


      /*
      * Atualizações do cadastro.
      */
      allow update: if

        /*
        * Super Admin pode alterar normalmente.
        */
        ehAdministrador()

        ||

        /*
        * O entregador pode alterar
        * somente sua disponibilidade.
        */
        (
          estaAutenticado()

          && request.auth.uid
            == driverId

          /*
          * Não permite alterar o UID.
          */
          && request.resource.data.uid
            == resource.data.uid

          /*
          * Não permite alterar a própria
          * aprovação ou bloqueio.
          */
          && request.resource.data.status
            == resource.data.status

          /*
          * Permite somente estes campos.
          */
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "disponivel",
              "atualizadoEm",
              "atualizadoEmMs"
            ])
        );


      allow delete: if false;
    }

    /*
    * Configuração geral pública.
    */
    match /platformSettings/general {
      allow read: if true;

      allow create, update:
        if ehAdministrador();

      allow delete: if false;
    }

    
    /*
    * Configurações globais da plataforma.
    * Somente o Super Admin pode acessar.
    */
    match /platformSettings/{settingId} {
      allow read: if ehAdministrador();
      allow create: if ehAdministrador();
      allow update: if ehAdministrador();
      allow delete: if false;
    }

    /*
     * Histórico administrativo.
     */
    match /adminLogs/{logId} {
      allow read: if ehAdministrador();
      allow write: if false;
    }


    /*
     * Qualquer caminho não descrito acima fica bloqueado.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
