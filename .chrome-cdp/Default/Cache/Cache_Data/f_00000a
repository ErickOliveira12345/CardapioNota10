const __vite__css = "/* ═══════════════════════════════════════════════════════\r\n   SISTEMA DE PEDIDOS — ESTILOS CLIENTE\r\n   Mobile-first | CSS Variables | Componentes reutilizáveis\r\n═══════════════════════════════════════════════════════ */\r\n\r\n/* ── Reset & Base ─────────────────────────────────────── */\r\n\r\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n\r\n:root {\r\n  --primary:        #FF6B35;\r\n  --primary-dark:   #E55A25;\r\n  --primary-light:  #FFF0EA;\r\n  --secondary:      #2C3E50;\r\n  --success:        #27AE60;\r\n  --warning:        #F39C12;\r\n  --danger:         #E74C3C;\r\n  --info:           #3498DB;\r\n  --purple:         #8E44AD;\r\n\r\n  --bg:             #F5F5F5;\r\n  --surface:        #FFFFFF;\r\n  --border:         #E8ECEF;\r\n  --text:           #2C3E50;\r\n  --text-light:     #7F8C8D;\r\n  --text-muted:     #BDC3C7;\r\n\r\n  --shadow-sm:  0 1px 4px rgba(0,0,0,.08);\r\n  --shadow:     0 2px 12px rgba(0,0,0,.10);\r\n  --shadow-lg:  0 8px 32px rgba(0,0,0,.14);\r\n\r\n  --radius-sm:  6px;\r\n  --radius:     12px;\r\n  --radius-lg:  20px;\r\n\r\n  --header-h:   60px;\r\n  --transition: .2s ease;\r\n}\r\n\r\nhtml { font-size: 16px; scroll-behavior: smooth; }\r\n\r\nbody {\r\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\r\n  background: var(--bg);\r\n  color: var(--text);\r\n  line-height: 1.5;\r\n  min-height: 100dvh;\r\n}\r\n\r\nbutton { cursor: pointer; border: none; background: none; font: inherit; }\r\n\r\nimg { max-width: 100%; display: block; }\r\n\r\na { text-decoration: none; color: inherit; }\r\n\r\nul, ol { list-style: none; }\r\n\r\ndetails summary { cursor: pointer; }\r\n\r\n/* ── Utilitários ──────────────────────────────────────── */\r\n\r\n.hidden { display: none !important; }\r\n\r\n/* ── Status badges (shared) ───────────────────────────── */\r\n\r\n.pedido-badge {\r\n  display: inline-flex; align-items: center; gap: .3rem;\r\n  padding: .25rem .75rem; border-radius: 100px;\r\n  font-size: .8rem; font-weight: 600;\r\n}\r\n\r\n.status--warning  { background: #FEF9C3; color: #854D0E; }\r\n\r\n.status--info     { background: #DBEAFE; color: #1E40AF; }\r\n\r\n.status--primary  { background: #FFEDD5; color: #9A3412; }\r\n\r\n.status--purple   { background: #F3E8FF; color: #6B21A8; }\r\n\r\n.status--success  { background: #DCFCE7; color: #166534; }\r\n\r\n.status--danger   { background: #FEE2E2; color: #991B1B; }\r\n\r\n/* ═══════════════════════════════════════════════════════\r\n   PÁGINA: INDEX.HTML — QR CODE SCAN\r\n═══════════════════════════════════════════════════════ */\r\n\r\n.page-qr {\r\n  background: linear-gradient(135deg, #FF6B35 0%, #E55A25 40%, #2C3E50 100%);\r\n  min-height: 100dvh;\r\n}\r\n\r\n.qr-page {\r\n  max-width: 480px;\r\n  margin: 0 auto;\r\n  padding: 2rem 1rem 4rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2rem;\r\n}\r\n\r\n/* Header da tela de QR */\r\n\r\n.qr-header {\r\n  text-align: center;\r\n  color: white;\r\n  padding-top: 1rem;\r\n}\r\n\r\n.qr-logo { font-size: 3rem; margin-bottom: .5rem; }\r\n\r\n.qr-restaurant-name { font-size: 1.6rem; font-weight: 700; }\r\n\r\n.qr-tagline { font-size: .95rem; opacity: .85; margin-top: .25rem; }\r\n\r\n/* Banner de sessão existente */\r\n\r\n.session-banner {\r\n  background: rgba(255,255,255,.15);\r\n  backdrop-filter: blur(8px);\r\n  border: 1px solid rgba(255,255,255,.3);\r\n  border-radius: var(--radius);\r\n  padding: 1rem;\r\n  color: white;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: .75rem;\r\n}\r\n\r\n.session-banner p { font-size: .95rem; }\r\n\r\n.session-banner strong { font-size: 1.1rem; }\r\n\r\n.session-actions { display: flex; gap: .5rem; }\r\n\r\n.btn-return {\r\n  flex: 1; padding: .6rem; border-radius: var(--radius-sm);\r\n  background: white; color: var(--primary); font-weight: 600;\r\n  transition: opacity var(--transition);\r\n}\r\n\r\n.btn-return:hover { opacity: .9; }\r\n\r\n.btn-new-session {\r\n  padding: .6rem 1rem; border-radius: var(--radius-sm);\r\n  border: 1px solid rgba(255,255,255,.5); color: white; font-size: .85rem;\r\n}\r\n\r\n/* Instrução de uso */\r\n\r\n.qr-instructions {\r\n  background: rgba(255,255,255,.12);\r\n  border-radius: var(--radius);\r\n  padding: 1rem 1.25rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: .6rem;\r\n}\r\n\r\n.instruction-step {\r\n  display: flex; align-items: center; gap: .75rem; color: white;\r\n}\r\n\r\n.step-num {\r\n  width: 24px; height: 24px; border-radius: 50%;\r\n  background: rgba(255,255,255,.25);\r\n  display: grid; place-items: center;\r\n  font-size: .8rem; font-weight: 700; flex-shrink: 0;\r\n}\r\n\r\n.instruction-step span:last-child { font-size: .9rem; opacity: .9; }\r\n\r\n/* Título da seção */\r\n\r\n.qr-section-title {\r\n  color: white;\r\n  text-align: center;\r\n  font-size: 1rem;\r\n  opacity: .8;\r\n}\r\n\r\n/* Grade de QR Codes */\r\n\r\n.qr-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: 1rem;\r\n}\r\n\r\n.qr-card {\r\n  background: white;\r\n  border-radius: var(--radius);\r\n  overflow: hidden;\r\n  box-shadow: var(--shadow-lg);\r\n  cursor: pointer;\r\n  transition: transform var(--transition), box-shadow var(--transition);\r\n}\r\n\r\n.qr-card:hover, .qr-card:focus {\r\n  transform: translateY(-4px) scale(1.02);\r\n  box-shadow: 0 16px 40px rgba(0,0,0,.2);\r\n  outline: 3px solid white;\r\n}\r\n\r\n.qr-card.scanning { transform: scale(0.96); }\r\n\r\n.qr-card__img-wrapper {\r\n  position: relative; aspect-ratio: 1;\r\n  background: #f9f9f9;\r\n  display: grid; place-items: center;\r\n  padding: 1rem;\r\n}\r\n\r\n.qr-card__img { width: 100%; height: 100%; object-fit: contain; }\r\n\r\n.qr-card__overlay {\r\n  position: absolute; inset: 0;\r\n  background: rgba(255,107,53,.9);\r\n  display: grid; place-items: center;\r\n  opacity: 0;\r\n  transition: opacity var(--transition);\r\n}\r\n\r\n.qr-card:hover .qr-card__overlay,\r\n.qr-card.scanning .qr-card__overlay { opacity: 1; }\r\n\r\n.qr-scan-icon { color: white; font-weight: 700; font-size: .9rem; text-align: center; }\r\n\r\n.qr-card__footer {\r\n  padding: .75rem 1rem;\r\n  display: flex; flex-direction: column; gap: .15rem;\r\n}\r\n\r\n.qr-card__mesa { font-weight: 700; font-size: 1rem; color: var(--text); }\r\n\r\n.qr-card__desc { font-size: .78rem; color: var(--text-light); }\r\n\r\n/* Link admin no fundo */\r\n\r\n.qr-admin-link {\r\n  text-align: center;\r\n  color: rgba(255,255,255,.6);\r\n  font-size: .85rem;\r\n}\r\n\r\n.qr-admin-link a {\r\n  color: rgba(255,255,255,.8);\r\n  text-decoration: underline;\r\n  transition: color var(--transition);\r\n}\r\n\r\n.qr-admin-link a:hover { color: white; }\r\n\r\n/* ═══════════════════════════════════════════════════════\r\n   PÁGINA: MENU.HTML — CARDÁPIO DO CLIENTE\r\n═══════════════════════════════════════════════════════ */\r\n\r\n.page-menu { background: var(--bg); padding-bottom: 5rem; }\r\n\r\n/* Header */\r\n\r\n.menu-header {\r\n  position: sticky; top: 0; z-index: 100;\r\n  height: var(--header-h);\r\n  background: var(--primary);\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  padding: 0 1rem;\r\n  box-shadow: 0 2px 8px rgba(255,107,53,.4);\r\n}\r\n\r\n.menu-header__left, .menu-header__right { display: flex; align-items: center; gap: .5rem; }\r\n\r\n.btn-back-home {\r\n  color: white; padding: .4rem .6rem;\r\n  border-radius: var(--radius-sm); font-size: .85rem;\r\n  transition: background var(--transition);\r\n}\r\n\r\n.btn-back-home:hover { background: rgba(255,255,255,.2); }\r\n\r\n.mesa-badge {\r\n  background: rgba(255,255,255,.2);\r\n  color: white; font-weight: 700; font-size: .9rem;\r\n  padding: .3rem .9rem; border-radius: 100px;\r\n}\r\n\r\n.btn-servico {\r\n  background: rgba(255,255,255,.95);\r\n  color: var(--primary); font-weight: 700; font-size: .8rem;\r\n  padding: .5rem .9rem; border-radius: 100px;\r\n  transition: all var(--transition);\r\n  white-space: nowrap;\r\n}\r\n\r\n.btn-servico:hover { background: white; box-shadow: 0 2px 8px rgba(0,0,0,.15); }\r\n\r\n/* Nav de categorias (abas sticky abaixo do header) */\r\n\r\n.categorias-nav {\r\n  position: sticky; top: var(--header-h); z-index: 90;\r\n  background: var(--surface);\r\n  display: flex; gap: .5rem;\r\n  padding: .6rem 1rem;\r\n  overflow-x: auto;\r\n  box-shadow: 0 1px 0 var(--border);\r\n  scrollbar-width: none;\r\n}\r\n\r\n.categorias-nav::-webkit-scrollbar { display: none; }\r\n\r\n.categoria-tab {\r\n  display: flex; align-items: center; gap: .35rem;\r\n  padding: .45rem 1rem;\r\n  border-radius: 100px;\r\n  border: 1.5px solid var(--border);\r\n  background: transparent;\r\n  color: var(--text-light); font-size: .85rem; font-weight: 500;\r\n  white-space: nowrap;\r\n  transition: all var(--transition);\r\n}\r\n\r\n.categoria-tab:hover { border-color: var(--primary); color: var(--primary); }\r\n\r\n.categoria-tab.active {\r\n  background: var(--primary); border-color: var(--primary);\r\n  color: white; font-weight: 600;\r\n}\r\n\r\n/* Seção de boas-vindas + cards de categoria */\r\n\r\n.welcome-section { padding: 1.25rem 1rem; }\r\n\r\n.welcome-hero {\r\n  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);\r\n  border-radius: var(--radius-lg);\r\n  padding: 1.5rem;\r\n  color: white;\r\n  text-align: center;\r\n  margin-bottom: 1.25rem;\r\n}\r\n\r\n.welcome-hero__emoji { font-size: 2.5rem; }\r\n\r\n.welcome-hero h2 { font-size: 1.3rem; margin: .4rem 0 .2rem; }\r\n\r\n.welcome-hero p { opacity: .85; font-size: .9rem; }\r\n\r\n.welcome-section h3 { font-size: 1rem; color: var(--text-light); margin-bottom: .75rem; }\r\n\r\n.categorias-grid {\r\n  display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem;\r\n}\r\n\r\n.categoria-card {\r\n  background: var(--surface); border-radius: var(--radius);\r\n  padding: 1.25rem 1rem; text-align: center;\r\n  box-shadow: var(--shadow-sm); border: 1.5px solid var(--border);\r\n  cursor: pointer; transition: all var(--transition);\r\n  display: flex; flex-direction: column; gap: .4rem; align-items: center;\r\n}\r\n\r\n.categoria-card:hover {\r\n  border-color: var(--primary); box-shadow: var(--shadow);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.categoria-card__icon { font-size: 2.2rem; }\r\n\r\n.categoria-card__nome { font-weight: 700; font-size: 1rem; color: var(--text); }\r\n\r\n.categoria-card__desc { font-size: .78rem; color: var(--text-light); line-height: 1.3; }\r\n\r\n.categoria-card__arrow { color: var(--primary); font-size: 1.1rem; margin-top: .2rem; }\r\n\r\n/* Seção de itens do cardápio */\r\n\r\n.itens-section { padding: 0 1rem 1rem; }\r\n\r\n.itens-header {\r\n  display: flex; align-items: center; gap: .75rem;\r\n  padding: 1rem 0 .75rem; position: sticky;\r\n  top: calc(var(--header-h) + 52px); z-index: 80;\r\n  background: var(--bg);\r\n}\r\n\r\n#btn-back-categorias {\r\n  color: var(--primary); font-weight: 600; font-size: .9rem;\r\n  padding: .3rem .6rem; border-radius: var(--radius-sm);\r\n  border: 1.5px solid var(--primary); transition: all var(--transition);\r\n}\r\n\r\n#btn-back-categorias:hover { background: var(--primary-light); }\r\n\r\n#categoria-titulo { font-size: 1.2rem; font-weight: 700; }\r\n\r\n.itens-grid { display: flex; flex-direction: column; gap: .75rem; }\r\n\r\n.item-card {\r\n  background: var(--surface); border-radius: var(--radius);\r\n  padding: 1rem; display: flex; align-items: center; gap: .9rem;\r\n  box-shadow: var(--shadow-sm); border: 1.5px solid transparent;\r\n  transition: all var(--transition);\r\n}\r\n\r\n.item-card:hover { border-color: var(--primary); box-shadow: var(--shadow); }\r\n\r\n.item-card__emoji { font-size: 2.4rem; flex-shrink: 0; }\r\n\r\n.item-card__info { flex: 1; min-width: 0; }\r\n\r\n.item-card__nome { font-weight: 700; font-size: .95rem; color: var(--text); }\r\n\r\n.item-card__desc { font-size: .78rem; color: var(--text-light); margin-top: .15rem; }\r\n\r\n.item-card__preco { font-size: 1rem; font-weight: 700; color: var(--primary); margin-top: .4rem; display: block; }\r\n\r\n.btn-add {\r\n  width: 40px; height: 40px; border-radius: 50%;\r\n  background: var(--primary); color: white;\r\n  font-size: 1.4rem; font-weight: 300; flex-shrink: 0;\r\n  display: grid; place-items: center;\r\n  transition: all var(--transition);\r\n}\r\n\r\n.btn-add:hover { background: var(--primary-dark); transform: scale(1.1); }\r\n\r\n.btn-add:active { transform: scale(.95); }\r\n\r\n/* Seção de status do pedido ativo */\r\n\r\n.pedido-status-section { padding: 1rem; }\r\n\r\n.pedido-status-section h3 {\r\n  font-size: 1rem; font-weight: 700; margin-bottom: .75rem;\r\n  display: flex; align-items: center; gap: .5rem;\r\n}\r\n\r\n.pedido-card {\r\n  background: var(--surface); border-radius: var(--radius);\r\n  padding: 1rem; box-shadow: var(--shadow-sm);\r\n  border-left: 4px solid var(--primary);\r\n}\r\n\r\n.pedido-card--finalizado { border-left-color: var(--success); }\r\n\r\n.pedido-card__header {\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  flex-wrap: wrap; gap: .4rem; margin-bottom: .75rem;\r\n}\r\n\r\n.pedido-hora { font-size: .8rem; color: var(--text-light); }\r\n\r\n/* Progress track de status */\r\n\r\n.status-track {\r\n  display: flex; align-items: flex-start;\r\n  gap: 0; margin: .75rem 0;\r\n  overflow-x: auto; padding-bottom: .25rem;\r\n}\r\n\r\n.status-step {\r\n  display: flex; flex-direction: column; align-items: center;\r\n  gap: .3rem; flex: 1; min-width: 64px; position: relative;\r\n}\r\n\r\n.status-step + .status-step::before {\r\n  content: ''; position: absolute; top: 14px; right: 50%;\r\n  width: 100%; height: 2px; background: var(--border);\r\n  z-index: 0;\r\n}\r\n\r\n.status-step.done + .status-step::before { background: var(--success); }\r\n\r\n.status-step__dot {\r\n  width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--border);\r\n  background: var(--surface); display: grid; place-items: center;\r\n  font-size: .8rem; z-index: 1; position: relative;\r\n  transition: all var(--transition);\r\n}\r\n\r\n.status-step.done .status-step__dot { background: var(--success); border-color: var(--success); color: white; }\r\n\r\n.status-step.active .status-step__dot {\r\n  background: var(--primary); border-color: var(--primary); color: white;\r\n  box-shadow: 0 0 0 4px rgba(255,107,53,.2);\r\n  animation: pulse-step .8s ease infinite;\r\n}\r\n\r\n@keyframes pulse-step {\r\n  0%, 100% { box-shadow: 0 0 0 4px rgba(255,107,53,.2); }\r\n  50%       { box-shadow: 0 0 0 8px rgba(255,107,53,.08); }\r\n}\r\n\r\n.status-step__label {\r\n  font-size: .65rem; color: var(--text-light); text-align: center; line-height: 1.2;\r\n}\r\n\r\n.status-step.active .status-step__label { color: var(--primary); font-weight: 600; }\r\n\r\n.status-step.done .status-step__label  { color: var(--success); }\r\n\r\n.pedido-detalhes {\r\n  margin-top: .75rem; border-top: 1px solid var(--border); padding-top: .75rem;\r\n}\r\n\r\n.pedido-detalhes summary {\r\n  font-size: .85rem; color: var(--text-light); font-weight: 500;\r\n  padding: .25rem 0;\r\n}\r\n\r\n.pedido-itens { margin: .5rem 0; display: flex; flex-direction: column; gap: .3rem; }\r\n\r\n.pedido-itens li { font-size: .85rem; color: var(--text-light); }\r\n\r\n.pedido-total { font-size: .9rem; color: var(--text); display: block; margin-top: .4rem; }\r\n\r\n/* ── Cart FAB ─────────────────────────────────────────── */\r\n\r\n.cart-fab {\r\n  position: fixed; bottom: 1.5rem; right: 1.25rem; z-index: 200;\r\n  width: 60px; height: 60px; border-radius: 50%;\r\n  background: var(--primary); color: white; font-size: 1.4rem;\r\n  box-shadow: 0 4px 20px rgba(255,107,53,.45);\r\n  display: grid; place-items: center;\r\n  transform: scale(0); opacity: 0;\r\n  transition: all .3s cubic-bezier(.175,.885,.32,1.275);\r\n}\r\n\r\n.cart-fab--visible { transform: scale(1); opacity: 1; }\r\n\r\n.cart-fab:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(255,107,53,.55); }\r\n\r\n.cart-fab .cart-badge {\r\n  position: absolute; top: -4px; right: -4px;\r\n  background: var(--danger); color: white;\r\n  border-radius: 50%; width: 22px; height: 22px;\r\n  font-size: .7rem; font-weight: 700;\r\n  display: grid; place-items: center;\r\n  border: 2px solid var(--bg);\r\n}\r\n\r\n/* ── Cart Sidebar ─────────────────────────────────────── */\r\n\r\n.cart-overlay {\r\n  position: fixed; inset: 0; z-index: 299;\r\n  background: rgba(0,0,0,.4);\r\n  opacity: 0; pointer-events: none;\r\n  transition: opacity var(--transition);\r\n}\r\n\r\n.cart-overlay.active { opacity: 1; pointer-events: all; }\r\n\r\n.cart-sidebar {\r\n  position: fixed; top: 0; right: 0; bottom: 0; z-index: 300;\r\n  width: min(380px, 100vw);\r\n  background: var(--surface);\r\n  display: flex; flex-direction: column;\r\n  transform: translateX(100%);\r\n  transition: transform .3s cubic-bezier(.4,0,.2,1);\r\n  box-shadow: var(--shadow-lg);\r\n}\r\n\r\n.cart-sidebar.open { transform: translateX(0); }\r\n\r\n.cart-header {\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  padding: 1rem 1.25rem;\r\n  background: var(--primary); color: white;\r\n  border-bottom: 1px solid var(--primary-dark);\r\n}\r\n\r\n.cart-header h3 { font-size: 1.1rem; font-weight: 700; }\r\n\r\n.btn-close-cart {\r\n  color: white; font-size: 1.5rem; line-height: 1;\r\n  padding: .25rem .4rem; border-radius: var(--radius-sm);\r\n  transition: background var(--transition);\r\n}\r\n\r\n.btn-close-cart:hover { background: rgba(255,255,255,.2); }\r\n\r\n.cart-body {\r\n  flex: 1; overflow-y: auto; padding: .75rem 1rem;\r\n}\r\n\r\n.cart-empty {\r\n  height: 100%; display: flex; flex-direction: column;\r\n  align-items: center; justify-content: center;\r\n  gap: .75rem; color: var(--text-light);\r\n}\r\n\r\n.cart-empty__icon { font-size: 3rem; }\r\n\r\n.cart-empty p { font-size: .95rem; }\r\n\r\n.cart-item {\r\n  display: flex; align-items: center; gap: .75rem;\r\n  padding: .75rem 0; border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.cart-item:last-child { border-bottom: none; }\r\n\r\n.cart-item__emoji { font-size: 1.8rem; flex-shrink: 0; }\r\n\r\n.cart-item__info { flex: 1; min-width: 0; }\r\n\r\n.cart-item__nome { font-size: .9rem; font-weight: 600; display: block; }\r\n\r\n.cart-item__preco { font-size: .85rem; color: var(--primary); font-weight: 700; }\r\n\r\n.cart-item__qty { display: flex; align-items: center; gap: .4rem; flex-shrink: 0; }\r\n\r\n.qty-btn {\r\n  width: 28px; height: 28px; border-radius: 50%;\r\n  border: 1.5px solid var(--border); font-size: 1rem; font-weight: 600;\r\n  display: grid; place-items: center; color: var(--text);\r\n  transition: all var(--transition);\r\n}\r\n\r\n.qty-btn:hover { border-color: var(--primary); color: var(--primary); }\r\n\r\n.qty-value { font-weight: 700; min-width: 20px; text-align: center; font-size: .9rem; }\r\n\r\n.cart-footer {\r\n  padding: 1rem 1.25rem;\r\n  border-top: 1px solid var(--border);\r\n  background: var(--surface);\r\n}\r\n\r\n.cart-total {\r\n  display: flex; justify-content: space-between; align-items: center;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.cart-total span { color: var(--text-light); }\r\n\r\n.cart-total strong { font-size: 1.3rem; color: var(--primary); }\r\n\r\n.btn-finalizar {\r\n  width: 100%; padding: 1rem;\r\n  background: var(--primary); color: white;\r\n  border-radius: var(--radius); font-weight: 700; font-size: 1rem;\r\n  transition: all var(--transition);\r\n}\r\n\r\n.btn-finalizar:hover { background: var(--primary-dark); }\r\n\r\n.btn-finalizar:active { transform: scale(.98); }\r\n\r\n/* ── Toast Notifications ──────────────────────────────── */\r\n\r\n#toast-container {\r\n  position: fixed; bottom: 5rem; left: 50%; transform: translateX(-50%);\r\n  z-index: 999; display: flex; flex-direction: column; gap: .5rem;\r\n  align-items: center; pointer-events: none;\r\n  width: min(360px, 90vw);\r\n}\r\n\r\n.toast {\r\n  display: flex; align-items: center; gap: .6rem;\r\n  background: var(--secondary); color: white;\r\n  padding: .75rem 1.1rem; border-radius: var(--radius);\r\n  font-size: .9rem; box-shadow: var(--shadow-lg);\r\n  opacity: 0; transform: translateY(12px) scale(.96);\r\n  transition: all .3s cubic-bezier(.4,0,.2,1);\r\n  pointer-events: all; max-width: 100%;\r\n}\r\n\r\n.toast--visible { opacity: 1; transform: translateY(0) scale(1); }\r\n\r\n.toast--success { background: #166534; }\r\n\r\n.toast--error   { background: #991B1B; }\r\n\r\n.toast--warning { background: #854D0E; }\r\n\r\n.toast__icon { font-size: 1rem; flex-shrink: 0; }\r\n\r\n/* ── Responsive ───────────────────────────────────────── */\r\n\r\n@media (min-width: 480px) {\r\n  .qr-grid { grid-template-columns: repeat(2, 1fr); }\r\n  .itens-grid { display: grid; grid-template-columns: repeat(2, 1fr); }\r\n  .item-card { flex-direction: column; align-items: flex-start; }\r\n  .item-card__emoji { font-size: 3rem; }\r\n}\r\n\r\n@media (min-width: 768px) {\r\n  .qr-page { max-width: 640px; }\r\n  .qr-grid { grid-template-columns: repeat(4, 1fr); }\r\n  .welcome-section, .itens-section, .pedido-status-section { padding-left: 2rem; padding-right: 2rem; }\r\n  .categorias-grid { grid-template-columns: repeat(4, 1fr); }\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .itens-grid { grid-template-columns: repeat(3, 1fr); }\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════\r\n   SISTEMA DE PEDIDOS — ESTILOS ADMIN\r\n   Dark header | Cards informativos | Responsive dashboard\r\n═══════════════════════════════════════════════════════ */\r\n\r\n/* Importa variáveis e reset do style.css */\r\n\r\n:root {\r\n  --primary:        #FF6B35;\r\n  --primary-dark:   #E55A25;\r\n  --primary-light:  #FFF0EA;\r\n  --secondary:      #2C3E50;\r\n  --success:        #27AE60;\r\n  --warning:        #F39C12;\r\n  --danger:         #E74C3C;\r\n  --info:           #3498DB;\r\n  --purple:         #8E44AD;\r\n  --bg:             #F0F2F5;\r\n  --surface:        #FFFFFF;\r\n  --border:         #E1E5EB;\r\n  --text:           #2C3E50;\r\n  --text-light:     #7F8C8D;\r\n  --shadow-sm:  0 1px 4px rgba(0,0,0,.08);\r\n  --shadow:     0 2px 12px rgba(0,0,0,.10);\r\n  --shadow-lg:  0 8px 32px rgba(0,0,0,.14);\r\n  --radius-sm:  6px;\r\n  --radius:     12px;\r\n  --radius-lg:  20px;\r\n  --transition: .2s ease;\r\n  --admin-header: 64px;\r\n}\r\n\r\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n\r\nhtml { font-size: 16px; }\r\n\r\nbody {\r\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\r\n  background: var(--bg); color: var(--text); line-height: 1.5;\r\n  min-height: 100dvh;\r\n}\r\n\r\nbutton { cursor: pointer; border: none; background: none; font: inherit; }\r\n\r\na { text-decoration: none; color: inherit; }\r\n\r\nul, ol { list-style: none; }\r\n\r\n.hidden { display: none !important; }\r\n\r\n/* ══ Status badges (mesmo do style.css) ═══════════════ */\r\n\r\n.pedido-badge, .admin-status-badge {\r\n  display: inline-flex; align-items: center; gap: .3rem;\r\n  padding: .25rem .75rem; border-radius: 100px;\r\n  font-size: .78rem; font-weight: 600; white-space: nowrap;\r\n}\r\n\r\n.status--warning  { background: #FEF9C3; color: #854D0E; }\r\n\r\n.status--info     { background: #DBEAFE; color: #1E40AF; }\r\n\r\n.status--primary  { background: #FFEDD5; color: #9A3412; }\r\n\r\n.status--purple   { background: #F3E8FF; color: #6B21A8; }\r\n\r\n.status--success  { background: #DCFCE7; color: #166534; }\r\n\r\n.status--danger   { background: #FEE2E2; color: #991B1B; }\r\n\r\n/* ══ Header Admin ══════════════════════════════════════ */\r\n\r\n.admin-header {\r\n  position: sticky; top: 0; z-index: 100;\r\n  height: var(--admin-header);\r\n  background: var(--secondary);\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  padding: 0 1.5rem;\r\n  box-shadow: 0 2px 12px rgba(0,0,0,.25);\r\n}\r\n\r\n.admin-header__brand {\r\n  display: flex; align-items: center; gap: .75rem; color: white;\r\n}\r\n\r\n.admin-header__brand-icon { font-size: 1.6rem; }\r\n\r\n.admin-header__brand-name { font-size: 1.1rem; font-weight: 700; }\r\n\r\n.admin-header__brand-sub {\r\n  font-size: .75rem; opacity: .6; font-weight: 400;\r\n}\r\n\r\n.admin-header__actions { display: flex; align-items: center; gap: .5rem; }\r\n\r\n.btn-client-view {\r\n  color: rgba(255,255,255,.75); font-size: .85rem;\r\n  padding: .45rem .85rem; border-radius: var(--radius-sm);\r\n  border: 1px solid rgba(255,255,255,.2);\r\n  transition: all var(--transition);\r\n}\r\n\r\n.btn-client-view:hover { background: rgba(255,255,255,.1); color: white; }\r\n\r\n.btn-clear {\r\n  color: #FC8181; font-size: .8rem;\r\n  padding: .45rem .85rem; border-radius: var(--radius-sm);\r\n  border: 1px solid rgba(252,129,129,.35);\r\n  transition: all var(--transition);\r\n}\r\n\r\n.btn-clear:hover { background: rgba(252,129,129,.1); }\r\n\r\n/* ══ Layout Principal ══════════════════════════════════ */\r\n\r\n.admin-main {\r\n  max-width: 1200px; margin: 0 auto;\r\n  padding: 1.5rem 1rem 3rem;\r\n  display: flex; flex-direction: column; gap: 1.5rem;\r\n}\r\n\r\n/* ══ Stats Cards ═══════════════════════════════════════ */\r\n\r\n.stats-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: .75rem;\r\n}\r\n\r\n.stat-card {\r\n  background: var(--surface); border-radius: var(--radius);\r\n  padding: 1rem 1.25rem;\r\n  box-shadow: var(--shadow-sm);\r\n  display: flex; align-items: center; gap: .9rem;\r\n  border-left: 4px solid transparent;\r\n  transition: box-shadow var(--transition);\r\n}\r\n\r\n.stat-card:hover { box-shadow: var(--shadow); }\r\n\r\n.stat-card--total     { border-left-color: var(--info); }\r\n\r\n.stat-card--aguardando{ border-left-color: var(--warning); }\r\n\r\n.stat-card--preparando{ border-left-color: var(--primary); }\r\n\r\n.stat-card--finalizado{ border-left-color: var(--success); }\r\n\r\n.stat-card--chamados  { border-left-color: var(--danger); }\r\n\r\n.stat-card__icon { font-size: 1.75rem; }\r\n\r\n.stat-card__body {}\r\n\r\n.stat-card__value { font-size: 1.7rem; font-weight: 800; line-height: 1; }\r\n\r\n.stat-card__label { font-size: .78rem; color: var(--text-light); margin-top: .15rem; }\r\n\r\n/* ══ Alertas de Atendimento ════════════════════════════ */\r\n\r\n.alertas-section {}\r\n\r\n.section-title {\r\n  font-size: 1rem; font-weight: 700; margin-bottom: .75rem;\r\n  display: flex; align-items: center; gap: .5rem;\r\n}\r\n\r\n.alertas-grid { display: flex; flex-direction: column; gap: .6rem; }\r\n\r\n.alerta-card {\r\n  background: #FFF5F5;\r\n  border: 2px solid var(--danger);\r\n  border-radius: var(--radius);\r\n  padding: .9rem 1rem;\r\n  display: flex; align-items: center; gap: .75rem;\r\n  animation: blink-border 1.2s ease infinite;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n@keyframes blink-border {\r\n  0%, 100% { border-color: var(--danger); background: #FFF5F5; }\r\n  50%       { border-color: #FC8181;      background: #FFF; }\r\n}\r\n\r\n.alerta-card__pulse {\r\n  position: absolute; top: 50%; left: -2px; transform: translateY(-50%);\r\n  width: 6px; height: 40%; border-radius: 0 4px 4px 0;\r\n  background: var(--danger);\r\n  animation: pulse-bar 1.2s ease infinite;\r\n}\r\n\r\n@keyframes pulse-bar {\r\n  0%, 100% { height: 60%; opacity: 1; }\r\n  50%       { height: 80%; opacity: .6; }\r\n}\r\n\r\n.alerta-card__body { flex: 1; }\r\n\r\n.alerta-mesa { display: block; font-weight: 700; font-size: .95rem; color: var(--danger); }\r\n\r\n.alerta-hora { font-size: .78rem; color: var(--text-light); }\r\n\r\n.btn-visualizado {\r\n  flex-shrink: 0; padding: .5rem .85rem;\r\n  border-radius: var(--radius-sm); font-size: .8rem; font-weight: 600;\r\n  background: var(--danger); color: white;\r\n  transition: all var(--transition);\r\n}\r\n\r\n.btn-visualizado:hover { background: #C0392B; }\r\n\r\n/* ══ Pedidos ═══════════════════════════════════════════ */\r\n\r\n.pedidos-section {}\r\n\r\n.pedidos-header {\r\n  display: flex; align-items: center;\r\n  justify-content: space-between; flex-wrap: wrap; gap: .5rem;\r\n  margin-bottom: .75rem;\r\n}\r\n\r\n.filtros-pedidos {\r\n  display: flex; gap: .4rem; flex-wrap: wrap;\r\n}\r\n\r\n.filtro-btn {\r\n  padding: .35rem .85rem; border-radius: 100px;\r\n  border: 1.5px solid var(--border); font-size: .82rem; color: var(--text-light);\r\n  transition: all var(--transition);\r\n}\r\n\r\n.filtro-btn:hover { border-color: var(--primary); color: var(--primary); }\r\n\r\n.filtro-btn.active {\r\n  background: var(--primary); border-color: var(--primary);\r\n  color: white; font-weight: 600;\r\n}\r\n\r\n.pedidos-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr;\r\n  gap: .75rem;\r\n}\r\n\r\n/* Card de pedido no admin */\r\n\r\n.pedido-card-admin {\r\n  background: var(--surface); border-radius: var(--radius);\r\n  padding: 1rem 1.1rem;\r\n  box-shadow: var(--shadow-sm);\r\n  border-top: 3px solid transparent;\r\n  transition: box-shadow var(--transition);\r\n}\r\n\r\n.pedido-card-admin:hover { box-shadow: var(--shadow); }\r\n\r\n.pedido-card-admin.card--warning  { border-top-color: var(--warning); }\r\n\r\n.pedido-card-admin.card--info     { border-top-color: var(--info); }\r\n\r\n.pedido-card-admin.card--primary  { border-top-color: var(--primary); }\r\n\r\n.pedido-card-admin.card--purple   { border-top-color: var(--purple); }\r\n\r\n.pedido-card-admin.card--success  { border-top-color: var(--success); }\r\n\r\n.pedido-card-admin.card--danger   { border-top-color: var(--danger); }\r\n\r\n.pedido-card-admin__header {\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  flex-wrap: wrap; gap: .4rem; margin-bottom: .75rem;\r\n}\r\n\r\n.pedido-card-admin__meta { display: flex; align-items: center; gap: .5rem; }\r\n\r\n.admin-mesa-badge {\r\n  background: var(--secondary); color: white;\r\n  padding: .25rem .75rem; border-radius: 100px;\r\n  font-weight: 700; font-size: .85rem;\r\n}\r\n\r\n.admin-pedido-id { font-size: .78rem; color: var(--text-muted, #BDC3C7); font-family: monospace; }\r\n\r\n/* Lista de itens dentro do card */\r\n\r\n.admin-itens-list {\r\n  display: flex; flex-direction: column; gap: .25rem;\r\n  margin-bottom: .75rem; padding: .5rem .75rem;\r\n  background: var(--bg); border-radius: var(--radius-sm);\r\n}\r\n\r\n.pedido-item-row {\r\n  display: flex; align-items: center; justify-content: space-between;\r\n  font-size: .85rem; color: var(--text); gap: .5rem;\r\n}\r\n\r\n.pedido-item-row span:first-child { flex: 1; }\r\n\r\n.pedido-item-row span:last-child { color: var(--text-light); font-size: .8rem; }\r\n\r\n/* Footer do card admin */\r\n\r\n.pedido-card-admin__footer {\r\n  display: flex; align-items: flex-end; justify-content: space-between;\r\n  flex-wrap: wrap; gap: .5rem;\r\n  border-top: 1px solid var(--border); padding-top: .75rem;\r\n}\r\n\r\n.admin-footer-meta { display: flex; flex-direction: column; gap: .2rem; }\r\n\r\n.admin-hora { font-size: .8rem; color: var(--text-light); }\r\n\r\n.admin-total { font-size: 1rem; font-weight: 700; color: var(--text); }\r\n\r\n.admin-status-select-wrap {\r\n  display: flex; flex-direction: column; gap: .2rem; align-items: flex-end;\r\n}\r\n\r\n.admin-status-select-wrap label { font-size: .75rem; color: var(--text-light); }\r\n\r\n.admin-status-select {\r\n  padding: .4rem .7rem; border-radius: var(--radius-sm);\r\n  border: 1.5px solid var(--border); font-size: .85rem;\r\n  background: var(--surface); color: var(--text);\r\n  cursor: pointer; transition: border-color var(--transition);\r\n  max-width: 220px;\r\n}\r\n\r\n.admin-status-select:focus { outline: none; border-color: var(--primary); }\r\n\r\n/* Empty state */\r\n\r\n.empty-state {\r\n  display: flex; flex-direction: column; align-items: center; justify-content: center;\r\n  gap: .75rem; padding: 3rem 1rem;\r\n  