rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function estaAutenticado() {
      return request.auth != null;
    }

    function ehProprietario(establishmentId) {
      return estaAutenticado()
        && firestore.exists(
          /databases/(default)/documents/establishments/$(establishmentId)
        )
        && firestore.get(
          /databases/(default)/documents/establishments/$(establishmentId)
        ).data.ownerId == request.auth.uid;
    }

    function imagemValida() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        );
    }

    /*
     * Imagens dos produtos.
     */
    match /establishments/{establishmentId}/products/{productId}/{fileName} {
      allow read: if true;

      allow create, update: if
        ehProprietario(establishmentId)
        && imagemValida();

      allow delete: if
        ehProprietario(establishmentId);
    }

    /*
     * Logotipo e identidade visual.
     */
    match /establishments/{establishmentId}/branding/{fileName} {
      allow read: if true;

      allow create, update: if
        ehProprietario(establishmentId)
        && imagemValida();

      allow delete: if
        ehProprietario(establishmentId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}